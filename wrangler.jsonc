// Cloudflare-Einstellungen für die Website mit Terminverwaltung.
// Geheimnisse (Passwort, Brevo-Schlüssel) stehen NICHT hier, sondern werden mit
// "npm run geheimnis -- NAME" bei Cloudflare hinterlegt (siehe ONLINE-STELLEN.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rheude-kobler",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rheude-kobler-termine",
      // wird beim Einrichten durch die echte ID ersetzt (npm run datenbank-anlegen)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // täglich 06:00 UTC = 7:00 Uhr Winterzeit / 8:00 Uhr Sommerzeit
  "triggers": { "crons": ["0 6 * * *"] },
  "vars": {
    "SITE_URL": "https://rheude-kobler.de",
    "PRAXIS_EMAIL": "termin@rheude-kobler.de",
    "MAIL_ABSENDER": "termin@rheude-kobler.de",
    "MAIL_NAME": "Rheude & Kobler",
    "PRAXIS_ADRESSE": "Am Bahnhofsplatz 5, 67459 Böhl-Iggelheim",
    "LOESCHEN_NACH_TAGEN": "180"
  },
  "observability": { "enabled": true }
}
